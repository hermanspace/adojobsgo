# =============================================================================
# Adojobs Bengkalis — contoh konfigurasi.
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# Tidak ada kredensial yang boleh di-hardcode di dalam kode.
# =============================================================================

# --- Aplikasi ----------------------------------------------------------------
APP_NAME=Adojobs
# local | prod. Nilainya ditimpa otomatis oleh berkas compose per lingkungan.
APP_ENV=local
APP_DEBUG=true
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
# Daftar IP/CIDR proxy yang dipercaya, dipisah koma. Di server isi dengan
# subnet jaringan ${DOCKER_NETWORK} tempat Nginx Proxy Manager bergabung
# (lihat DOCKER_SUBNET di bawah), contoh: 172.23.0.0/24
APP_TRUSTED_PROXIES=
# Header pembawa IP klien asli. Lokal: X-Forwarded-For. Di belakang
# Cloudflare WAJIB CF-Connecting-IP — X-Forwarded-For bisa dipalsukan klien.
APP_PROXY_HEADER=X-Forwarded-For

# Nama project compose; membedakan container bila beberapa project di satu host.
COMPOSE_PROJECT_NAME=adojobsid

# --- PostgreSQL --------------------------------------------------------------
# Host mengikuti nama service di docker-compose; ganti hanya bila memakai
# database di luar compose (mis. layanan terkelola).
POSTGRES_HOST=postgres
POSTGRES_USER=adojobs
POSTGRES_PASSWORD=ubah_kata_sandi_ini
POSTGRES_DB=adojobs
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
# Ukuran pool aplikasi. Server Postgres bawaan mengizinkan 100 koneksi, 3 di
# antaranya dicadangkan superuser → 97 tersedia untuk semua klien sekaligus:
# aplikasi ini, migrasi, alat admin, dan instance kedua bila ada. Aplikasi
# menolak menyala bila nilai ini melebihi yang tersedia, dan memperingatkan
# bila melewati separuhnya.
POSTGRES_MAX_CONNS=10
# Port yang dibuka ke host di lingkungan lokal saja (menghindari bentrok 5432).
POSTGRES_PORT_HOST=5433

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ubah_kata_sandi_redis_ini
REDIS_DB=0
# Masa berlaku cache hasil pencarian dan daftar kategori (detik).
REDIS_CACHE_TTL_SECONDS=300
REDIS_PORT_HOST=6380

# --- Sesi --------------------------------------------------------------------
SESSION_COOKIE_NAME=adojobs_session
# WAJIB minimal 32 karakter. Hasilkan dengan: openssl rand -base64 48
SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter
# 720 jam = 30 hari
SESSION_TTL_HOURS=720
# Harus true di server (HTTPS), false saat lokal (HTTP).
SESSION_COOKIE_SECURE=false

# --- Unggah foto -------------------------------------------------------------
# Push ke Android lewat Firebase Cloud Messaging (HTTP v1). Kosongkan keduanya
# untuk mematikan push; notifikasi tetap tersimpan dan tampil di aplikasi.
# Berkas service account diunduh dari Firebase Console → Project settings →
# Service accounts, lalu dipasang ke container (mis. lewat volume).
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
UPLOAD_DIR=/app/storage/uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_MAX_PER_LISTING=6

# Kata sandi seluruh akun demo untuk `make seed-demo`; kosongkan untuk acak (dicetak di log).
DEMO_PASSWORD=

# --- Admin pertama -----------------------------------------------------------
# Dipakai `make admin-create`. Bila nomornya sudah terdaftar sebagai pengguna,
# akun itu dinaikkan menjadi admin, bukan dibuat ganda.
ADMIN_NAME=Administrator
ADMIN_PHONE=
# Minimal 12 karakter.
ADMIN_PASSWORD=

# --- Image & deploy ----------------------------------------------------------
APP_IMAGE=adojobsid-app
APP_TAG=latest
APP_VERSION=dev
# Nama jaringan Docker di server; Nginx Proxy Manager harus bergabung ke sini.
DOCKER_NETWORK=adojobsid_internal
# Subnet jaringan itu, ditetapkan eksplisit supaya APP_TRUSTED_PROXIES pasti.
# Pilih yang belum dipakai jaringan Docker lain di server (docker network ls).
DOCKER_SUBNET=172.23.0.0/24
# Folder di server yang di-mount baca-saja ke /app/secrets (berkas FCM, dll).
SECRETS_DIR=./secrets

# Tujuan `make deploy`. Kosongkan DEPLOY_REGISTRY untuk mengirim image
# langsung lewat SSH (docker save | ssh docker load), tanpa perlu registry.
DEPLOY_HOST=
DEPLOY_USER=deploy
DEPLOY_PORT=22
DEPLOY_PATH=/opt/adojobsid
DEPLOY_REGISTRY=

# --- Alat bantu pengembangan (profil "tools") --------------------------------
ADMINER_PORT=8080
PGWEB_PORT=8081
