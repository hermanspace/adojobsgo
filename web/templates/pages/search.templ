package pages

import (
	"strconv"

	"github.com/hermansyah/adojobsid/internal/view"
	"github.com/hermansyah/adojobsid/web/templates/components"
	"github.com/hermansyah/adojobsid/web/templates/layout"
)

// Search adalah halaman pencarian jasa.
// Di mobile: kolom pencarian penuh, baris chip kategori yang bisa digeser,
// dan panel filter yang muncul dari bawah. Di desktop: filter jadi sidebar tetap.
templ Search(d view.SearchData) {
	@layout.Base(d.Base) {
		<div class="container-app py-4 md:py-8">
			<form
				action="/cari"
				method="get"
				class="mb-4"
				role="search"
				hx-get="/cari/hasil"
				hx-target="#hasil-pencarian"
				hx-swap="innerHTML"
				hx-push-url="true"
				hx-trigger="submit, input from:#q delay:400ms, change from:select"
				hx-indicator="#indikator-cari"
			>
				<div class="relative">
					<span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2" style="color: var(--text-subtle)">
						@components.Icon("cari", "h-5 w-5")
					</span>
					<input
						id="q"
						type="search"
						name="q"
						value={ d.Query }
						class="input pl-11 pr-3 text-base"
						placeholder="Servis AC, tukang bangunan, dekorasi…"
						aria-label="Kata kunci pencarian"
						autocomplete="off"
					/>
				</div>
				<!-- Nilai filter ikut terkirim saat kata kunci berubah. -->
				<input type="hidden" name="kategori" value={ d.CategorySlug }/>
				<!-- Dua kolom di ponsel: tiga dropdown berdampingan di lebar 375px
				     membuat labelnya terpotong dan tidak terbaca. -->
				<div class="mt-3 grid grid-cols-2 gap-2 sm:flex sm:items-center">
					<label for="radius" class="sr-only">Radius</label>
					<select id="radius" name="radius" class="input !min-h-0 h-10 w-full text-sm sm:flex-1">
						<option value="">Semua jarak</option>
						for _, r := range d.PilihanRadius() {
							if r == d.RadiusKm {
								<option value={ strconv.Itoa(r) } selected>Dalam { strconv.Itoa(r) } km</option>
							} else {
								<option value={ strconv.Itoa(r) }>Dalam { strconv.Itoa(r) } km</option>
							}
						}
					</select>
					<label for="kecamatan" class="sr-only">Kecamatan</label>
					<select id="kecamatan" name="kecamatan" class="input !min-h-0 h-10 w-full text-sm sm:flex-1">
						<option value="">Semua kecamatan</option>
						for _, k := range d.KecamatanOps {
							if k == d.Kecamatan {
								<option value={ k } selected>{ k }</option>
							} else {
								<option value={ k }>{ k }</option>
							}
						}
					</select>
					<label for="urut" class="sr-only">Urutkan</label>
					<select id="urut" name="urut" class="input !min-h-0 h-10 w-full text-sm sm:flex-1">
						@opsiUrut("terdekat", "Terdekat", d.Sort)
						@opsiUrut("terbaru", "Terbaru", d.Sort)
						@opsiUrut("rating", "Rating tertinggi", d.Sort)
						@opsiUrut("termurah", "Harga terendah", d.Sort)
						@opsiUrut("termahal", "Harga tertinggi", d.Sort)
					</select>
					<label for="harga" class="sr-only">Jenis harga</label>
					<select id="harga" name="harga" class="input !min-h-0 h-10 w-full text-sm sm:flex-1">
						<option value="">Semua jenis harga</option>
						@opsiHarga("fixed", "Harga tetap", d.PriceType)
						@opsiHarga("hourly", "Per jam", d.PriceType)
						@opsiHarga("negotiable", "Nego", d.PriceType)
					</select>
					<noscript><button type="submit" class="btn btn-primary !min-h-0 h-10">Cari</button></noscript>
				</div>
				<label class="mt-2 flex items-center gap-2 text-sm">
					<input
						type="checkbox"
						name="menjangkau"
						value="1"
						class="h-4 w-4 rounded-xs"
						checked?={ d.OnlyReachable }
					/>
					<span style="color: var(--text-muted)">Hanya yang siap datang ke lokasi saya</span>
				</label>
			</form>
			<!-- Chip kategori: baris yang bisa digeser horizontal di layar sempit. -->
			<div class="scroll-x -mx-4 mb-5 px-4 pb-1">
				<a
					href="/cari"
					class={ "chip", templ.KV("is-active", d.CategorySlug == "") }
					aria-pressed={ ditekan(d.CategorySlug == "") }
				>
					Semua
				</a>
				for _, k := range d.Kategori {
					<a
						href={ templ.SafeURL(d.URLDengan("kategori", k.Slug)) }
						class={ "chip", templ.KV("is-active", d.CategorySlug == k.Slug) }
						aria-pressed={ ditekan(d.CategorySlug == k.Slug) }
					>
						{ k.Name }
					</a>
				}
			</div>
			<div class="mb-3">
				@components.PemilihLokasi(d.Base, "/cari")
			</div>
			<div id="anchor-hasil" class="mb-3 flex items-center justify-between gap-3">
				<div>
					<h1 class="text-xl font-bold sm:text-2xl">{ judulPencarian(d) }</h1>
					@components.HitungHasil(d.Total)
					<a href="/penyedia" class="text-xs font-semibold" style="color: var(--primary-solid)">
						Telusuri per penyedia
					</a>
				</div>
				<span id="indikator-cari">
					@components.Spinner("")
				</span>
			</div>
			<!-- Iklan sengaja di luar #hasil-pencarian: fragmen itu ditukar HTMX
			     setiap filter berubah, dan iklan yang ikut di dalamnya akan
			     dimuat ulang terus-menerus. -->
			if slot := d.Base.SlotIklan("cari_atas"); slot != nil {
				<div class="mb-4">
					@components.Iklan(slot)
				</div>
			}
			<div id="hasil-pencarian">
				@HasilPencarian(d)
			</div>
		</div>
	}
}

// HasilPencarian adalah fragmen yang ditukar oleh HTMX saat filter berubah,
// sehingga halaman tidak perlu dimuat ulang seluruhnya.
templ HasilPencarian(d view.SearchData) {
	if len(d.Items) == 0 {
		@components.EmptyState(
			"Belum ada jasa yang cocok",
			"Coba ganti kata kunci, pilih kecamatan lain, atau hapus filter kategori.",
		) {
			<a href="/cari" class="btn btn-secondary mt-4">Hapus semua filter</a>
		}
	} else {
		@components.ListingGrid(d.Items)
		if d.HasNext() {
			<div class="mt-6 flex justify-center">
				<button
					type="button"
					class="btn btn-secondary"
					hx-get={ d.URLHalaman(d.Page + 1) }
					hx-target="#hasil-pencarian"
					hx-swap="innerHTML"
					hx-push-url="true"
				>
					Muat lebih banyak
					<span class="text-xs" style="color: var(--text-muted)">
						({ strconv.Itoa(d.Page) } / { strconv.Itoa(d.TotalPages) })
					</span>
				</button>
			</div>
		}
	}
}

templ opsiUrut(value string, label string, current string) {
	if value == current || (value == "terbaru" && current == "") {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ opsiHarga(value string, label string, current string) {
	if value == current {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

func ditekan(v bool) string {
	if v {
		return "true"
	}
	return "false"
}

func judulPencarian(d view.SearchData) string {
	ringkas := d.RingkasanFilter()
	kategori := d.NamaKategori()

	switch {
	case ringkas != "" && kategori != "":
		return kategori + " — " + ringkas
	case ringkas != "":
		return "Hasil untuk " + ringkas
	case kategori != "":
		return "Jasa " + kategori
	default:
		return "Jasa di Bengkalis"
	}
}
