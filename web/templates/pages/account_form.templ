package pages

import (
	"github.com/hermansyah/adojobsid/internal/view"
	"github.com/hermansyah/adojobsid/web/templates/components"
	"github.com/hermansyah/adojobsid/web/templates/layout"
)

// AccountForm adalah form data akun: nama, email, dan lokasi.
// Nomor HP tidak bisa diubah di sini karena merupakan identitas login.
templ AccountForm(d view.AuthData) {
	@layout.Base(d.Base) {
		<div class="container-app py-6 md:py-10">
			<div class="mx-auto max-w-2xl">
				<a href="/dasbor" class="mb-4 inline-flex items-center gap-1 text-sm font-medium" style="color: var(--text-muted)">
					@components.Icon("panah-kiri", "h-4 w-4")
					Kembali ke dasbor
				</a>
				<h1 class="font-display text-2xl font-extrabold sm:text-3xl">Data akun</h1>
				@components.FlashMessage(d.Flash)
				<form action="/akun/profil" method="post" class="mt-6" novalidate>
					<div class="sm:surface-panel sm:p-6">
						@components.Field("full_name", "Nama lengkap", "", d.Form.Err("full_name")) {
							<input
								id="full_name"
								name="full_name"
								type="text"
								class="input"
								value={ d.Form.Value("full_name") }
								aria-invalid={ ditekan(d.Form.HasErr("full_name")) }
								required
							/>
						}
						@components.Field("phone_display", "Nomor HP", "Nomor HP dipakai untuk masuk dan tidak dapat diubah sendiri.", "") {
							<input
								id="phone_display"
								type="tel"
								class="input"
								value={ d.Form.Value("phone") }
								disabled
								style="opacity: .7"
							/>
						}
						@components.Field("email", "Email (opsional)", "Bisa dipakai sebagai alternatif untuk masuk.", d.Form.Err("email")) {
							<input
								id="email"
								name="email"
								type="email"
								class="input"
								placeholder="nama@email.com"
								value={ d.Form.Value("email") }
								aria-invalid={ ditekan(d.Form.HasErr("email")) }
							/>
						}
						@components.Field("kecamatan", "Kecamatan", "", d.Form.Err("kecamatan")) {
							<select id="kecamatan" name="kecamatan" class="input">
								<option value="">Pilih kecamatan</option>
								for _, k := range kecamatanBengkalis() {
									if d.Form.Selected("kecamatan", k) {
										<option value={ k } selected>{ k }</option>
									} else {
										<option value={ k }>{ k }</option>
									}
								}
							</select>
						}
						@components.Field("city", "Kota/Kabupaten", "", d.Form.Err("city")) {
							<input
								id="city"
								name="city"
								type="text"
								class="input"
								value={ d.Form.Value("city") }
								placeholder="Bengkalis"
							/>
						}
					</div>
					<div class="mt-6 flex flex-col gap-2 sm:flex-row-reverse">
						<button type="submit" class="btn btn-primary btn-lg sm:min-w-[12rem]">Simpan perubahan</button>
						<a href="/dasbor" class="btn btn-secondary btn-lg">Batal</a>
					</div>
				</form>
			</div>
		</div>
	}
}
