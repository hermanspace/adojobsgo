package pages

import (
	"strconv"

	"github.com/hermansyah/adojobsid/internal/view"
	"github.com/hermansyah/adojobsid/web/templates/layout"
)

// ErrorPage dipakai untuk 404 dan 500.
templ ErrorPage(d view.ErrorData) {
	@layout.Base(d.Base) {
		<div class="container-app flex min-h-[60vh] flex-col items-center justify-center py-12 text-center">
			if d.Code > 0 {
				<p class="font-display text-5xl font-extrabold" style="color: var(--text-subtle)">
					{ strconv.Itoa(d.Code) }
				</p>
			}
			<h1 class="mt-3 font-display text-2xl font-extrabold sm:text-3xl">{ d.Heading }</h1>
			<p class="mt-2 max-w-prose text-sm" style="color: var(--text-muted)">{ d.Message }</p>
			<div class="mt-6 flex flex-col gap-2 sm:flex-row">
				<a href="/" class="btn btn-primary btn-lg">Kembali ke beranda</a>
				<a href="/cari" class="btn btn-secondary btn-lg">Cari jasa</a>
			</div>
		</div>
	}
}
