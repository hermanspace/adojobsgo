		case "kunci-inggris":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M15.5 3.5a5 5 0 0 0-4.6 7l-6.3 6.3a2 2 0 0 0 0 2.8l.3.3a2 2 0 0 0 2.8 0l6.3-6.3a5 5 0 0 0 5.9-6.6l-2.7 2.7-2.4-.6-.6-2.4 2.7-2.7a5 5 0 0 0-1.4-.5Z"></path>
			</svg>
		case "rumah-bangun":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 20.5V10l8-6 8 6v10.5"></path>
				<path d="M4 20.5h16"></path>
				<path d="M9.5 20.5V14h5v6.5"></path>
				<path d="M2.5 11.5 12 4.2l9.5 7.3"></path>
			</svg>
		case "kamera":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4.5 7.5h3l1.4-2h6.2l1.4 2h3a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18V9a1.5 1.5 0 0 1 1.5-1.5Z"></path>
				<circle cx="12" cy="13" r="3.4"></circle>
			</svg>
		case "sapu":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M15.5 3.5 9 10"></path>
				<path d="m7.2 9.3 4.5 4.5-1.3 1.3a3.2 3.2 0 0 1-4.5 0l-.5-.5-1.1 4.9 4.9-1.1"></path>
				<path d="m11.7 13.8 5.4-5.4a1.9 1.9 0 0 0 0-2.7l-.3-.3"></path>
			</svg>
		case "pesta":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m4 20.5 3.5-10 6.5 6.5-10 3.5Z"></path>
				<path d="M13 3.5v2M17.5 5.5l-1.4 1.4M20.5 10h-2M18.8 14.7l-1.6-1"></path>
				<path d="M9.5 8.5c1.5-1.5 4-1.5 5.5 0s1.5 4 0 5.5"></path>
			</svg>
		case "truk":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M2.5 7.5A1.5 1.5 0 0 1 4 6h8.5v10H4a1.5 1.5 0 0 1-1.5-1.5v-7Z"></path>
				<path d="M12.5 9.5h4l3 3.2V16h-7V9.5Z"></path>
				<circle cx="7" cy="18" r="1.8"></circle>
				<circle cx="17" cy="18" r="1.8"></circle>
			</svg>
		case "laptop":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="4" y="5" width="16" height="11" rx="1.8"></rect>
				<path d="M2.5 19h19"></path>
			</svg>
		case "gunting":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="6.5" cy="17.5" r="2.5"></circle>
				<circle cx="6.5" cy="6.5" r="2.5"></circle>
				<path d="M8.6 8.4 19 19M19 5 8.6 15.6"></path>
			</svg>
		case "buku":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4.5 4.5h9A3.5 3.5 0 0 1 17 8v11.5H8a3.5 3.5 0 0 1-3.5-3.5v-11.5Z"></path>
				<path d="M17 8a3.5 3.5 0 0 1 2.5-3.5V19a3.5 3.5 0 0 0-2.5.5"></path>
			</svg>
		case "petir":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M13.5 2.5 5 13.5h6L10.5 21.5 19 10.5h-6l.5-8Z"></path>
			</svg>
		default:
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="8.5"></circle>
			</svg>
