package components

import "github.com/hermansyah/adojobsid/internal/view"

// Icon merender ikon garis inline. Seluruh ikon memakai grid 24x24, stroke 1.75,
// ujung membulat, dan mewarisi warna teks induknya lewat currentColor —
// tidak ada emoji yang dipakai sebagai pengganti ikon di mana pun.
templ Icon(name string, class string) {
	switch name {
		case "cari":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.5-3.5"></path>
			</svg>
		case "megafon":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 10v4a1 1 0 0 0 1 1h3l6 4V5L8 9H5a1 1 0 0 0-1 1Z"></path>
				<path d="M17 9.5a3.5 3.5 0 0 1 0 5"></path>
				<path d="M8 15v4h2.5"></path>
			</svg>
		case "bagikan":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 3v12"></path>
				<path d="m7.5 7.5 4.5-4.5 4.5 4.5"></path>
				<path d="M5 12v7h14v-7"></path>
			</svg>
		case "salin":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="9" y="9" width="11" height="11" rx="2"></rect>
				<path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"></path>
			</svg>
		case "mata":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12s-3.5 6.5-9.5 6.5S2.5 12 2.5 12Z"></path>
				<circle cx="12" cy="12" r="2.8"></circle>
			</svg>
		case "menu":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 7h16"></path>
				<path d="M4 12h16"></path>
				<path d="M4 17h10"></path>
			</svg>
		case "unduh":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 4v11"></path>
				<path d="m7.5 10.5 4.5 4.5 4.5-4.5"></path>
				<path d="M5 19h14"></path>
			</svg>
		case "info":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="8.5"></circle>
				<path d="M12 11v5"></path>
				<path d="M12 8h.01"></path>
			</svg>
		case "beranda":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M3 10.5 12 3l9 7.5"></path>
				<path d="M5.5 9.5V20h13V9.5"></path>
				<path d="M9.5 20v-5.5h5V20"></path>
			</svg>
		case "tambah":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
				<path d="M12 8.5v7M8.5 12h7"></path>
			</svg>
		case "pesanan":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M8 4H6.5A1.5 1.5 0 0 0 5 5.5v14A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5v-14A1.5 1.5 0 0 0 17.5 4H16"></path>
				<rect x="8" y="2.5" width="8" height="3.5" rx="1.25"></rect>
				<path d="M8.5 11h7M8.5 15h4.5"></path>
			</svg>
		case "akun":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="8.5" r="3.75"></circle>
				<path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
			</svg>
		case "matahari":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
			</svg>
		case "bulan":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
			</svg>
		case "bintang":
			<svg class={ class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M12 3.6l2.42 4.9 5.41.79-3.92 3.82.93 5.39L12 15.96l-4.84 2.54.93-5.39L4.17 9.29l5.41-.79L12 3.6Z"></path>
			</svg>
		case "lokasi":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 21s6.5-5.4 6.5-10.1A6.5 6.5 0 0 0 5.5 10.9C5.5 15.6 12 21 12 21Z"></path>
				<circle cx="12" cy="10.6" r="2.4"></circle>
			</svg>
		case "terverifikasi":
			<svg class={ class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M12 2.5l2.2 1.6 2.7-.2.9 2.6 2.2 1.6-.9 2.6.9 2.6-2.2 1.6-.9 2.6-2.7-.2L12 21.5l-2.2-1.6-2.7.2-.9-2.6-2.2-1.6.9-2.6-.9-2.6 2.2-1.6.9-2.6 2.7.2L12 2.5Z" opacity="0.18"></path>
				<path d="M12 2.5l2.2 1.6 2.7-.2.9 2.6 2.2 1.6-.9 2.6.9 2.6-2.2 1.6-.9 2.6-2.7-.2L12 21.5l-2.2-1.6-2.7.2-.9-2.6-2.2-1.6.9-2.6-.9-2.6 2.2-1.6.9-2.6 2.7.2L12 2.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
				<path d="m8.6 12.2 2.3 2.3 4.5-4.6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		case "panah-kanan":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M5 12h13M13 6.5 18.5 12 13 17.5"></path>
			</svg>
		case "panah-kiri":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M19 12H6M11 6.5 5.5 12 11 17.5"></path>
			</svg>
		case "foto":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="3.5" y="4.5" width="17" height="15" rx="3"></rect>
				<circle cx="9" cy="10" r="1.6"></circle>
				<path d="m4.5 17 4.2-4a1.8 1.8 0 0 1 2.5 0l5 4.8"></path>
				<path d="m14.5 14 1.6-1.5a1.8 1.8 0 0 1 2.5 0l1.9 1.8"></path>
			</svg>
		case "unggah":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 16V4.5"></path>
				<path d="m7.5 9 4.5-4.5L16.5 9"></path>
				<path d="M4.5 15v3A2.5 2.5 0 0 0 7 20.5h10a2.5 2.5 0 0 0 2.5-2.5v-3"></path>
			</svg>
		case "tutup":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m6.5 6.5 11 11M17.5 6.5l-11 11"></path>
			</svg>
		case "filter":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 7h16M7 12h10M10 17h4"></path>
			</svg>
		case "ubah":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4.5 19.5h4l9.6-9.6a2.1 2.1 0 0 0 0-3l-1-1a2.1 2.1 0 0 0-3 0l-9.6 9.6v4Z"></path>
				<path d="m14.5 6.5 3 3"></path>
			</svg>
		case "hapus":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4.5 7h15M9.5 7V5.5A1.5 1.5 0 0 1 11 4h2a1.5 1.5 0 0 1 1.5 1.5V7"></path>
				<path d="M6.5 7l.8 12A1.5 1.5 0 0 0 8.8 20.5h6.4a1.5 1.5 0 0 0 1.5-1.4l.8-12"></path>
			</svg>
		case "keluar":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M14 4.5h3A2.5 2.5 0 0 1 19.5 7v10a2.5 2.5 0 0 1-2.5 2.5h-3"></path>
				<path d="M10 8.5 6 12l4 3.5M6 12h9"></path>
			</svg>
		case "peringatan":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="8.5"></circle>
				<path d="M12 7.8v4.6M12 15.8v.4"></path>
			</svg>
		case "sukses":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="8.5"></circle>
				<path d="m8.4 12.2 2.4 2.4 4.8-4.9"></path>
			</svg>
		case "muat":
			<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M12 3.5a8.5 8.5 0 1 0 8.5 8.5" opacity="0.9"></path>
