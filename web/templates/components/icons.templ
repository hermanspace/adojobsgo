// LogoPlay merender lambang Google Play. Sengaja dipisah dari Icon karena
// aturan Icon — satu warna, mewarisi currentColor — tidak berlaku untuk logo:
// lambang ini harus tetap berwarna sama pada tema terang maupun gelap agar
// dikenali. Bentuknya empat sisi lipatan yang bertemu di satu titik.
templ LogoPlay(class string) {
	<svg class={ class } viewBox="0 0 24 24" aria-hidden="true">
		<path d="M4 2.3 13.75 12 4 21.7A1.3 1.3 0 0 1 3.5 20.6V3.4A1.3 1.3 0 0 1 4 2.3Z" fill="#00C3FF"></path>
		<path d="M4 2.3 16.85 8.8 13.75 12Z" fill="#00E05B"></path>
		<path d="M4 21.7 13.75 12l3.1 3.2Z" fill="#FF3B48"></path>
		<path d="m16.85 8.8 3.35 1.7a1.7 1.7 0 0 1 0 3l-3.35 1.7L13.75 12Z" fill="#FFC500"></path>
	</svg>
}

// LencanaPlaystore adalah lencana aplikasi Android di hero.
//
// Selama aplikasinya belum terbit, tautannya dibiarkan kosong dan lencananya
// dirender sebagai <span> — bukan <a> tanpa href, yang tetap terbaca sebagai
// tautan oleh pembaca layar dan tetap bisa difokus lewat papan ketik meski
// tidak menuju ke mana pun.
templ LencanaPlaystore(s view.SitusRingkas) {
	if s.AplikasiDapatDiklik() {
		<a
			href={ templ.SafeURL(s.PlaystoreURL) }
			target="_blank"
			rel="noopener"
			class="lencana-aplikasi"
		>
			@isiLencanaPlaystore(s)
		</a>
	} else {
		<span class="lencana-aplikasi lencana-aplikasi-mati">
			@isiLencanaPlaystore(s)
		</span>
	}
}

templ isiLencanaPlaystore(s view.SitusRingkas) {
	@LogoPlay("h-7 w-7 shrink-0")
	<span>
		if s.PlaystoreTeksAtas != "" {
			<span class="lencana-aplikasi-baris1">{ s.PlaystoreTeksAtas }</span>
		}
		if s.PlaystoreTeksBawah != "" {
			<span class="lencana-aplikasi-baris2">{ s.PlaystoreTeksBawah }</span>
		}
	</span>
}

// IkonMerek merender lambang platform pihak ketiga sebagai bidang berisi
// (fill), mengikuti currentColor — satu warna, seperti ikon lainnya — supaya
// tetap senada di mode terang maupun gelap.
templ IkonMerek(nama string, class string) {
	switch nama {
		case "whatsapp":
			<svg class={ class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path>
			</svg>
		case "facebook":
			<svg class={ class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
			</svg>
		case "telegram":
			<svg class={ class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"></path>
			</svg>
		case "x":
			<svg class={ class } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
			</svg>
		default:
			@Icon("bagikan", class)
	}
}
