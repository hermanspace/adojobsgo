package components

import (
	"fmt"

	"github.com/hermansyah/adojobsid/internal/model"
	"github.com/hermansyah/adojobsid/internal/view"
)

// ListingCard adalah kartu jasa di halaman pencarian dan beranda.
// Susunan informasi mengikuti urutan pengambilan keputusan pencari jasa:
// foto -> kategori -> judul -> harga -> rating & lokasi penyedia.
templ ListingCard(c model.ServiceCard) {
	<article class={ "listing-card",
		templ.KV("is-sorot-penyedia", c.PenyediaDisorot()), templ.KV("is-sorot", c.IsFeatured()) }>
		if c.IsFeatured() {
			<span class="pita-sorot"></span>
		} else if c.PenyediaDisorot() {
			<span class="pita-sorot-penyedia"></span>
		}
		<a href={ templ.SafeURL(fmt.Sprintf("/jasa/%d", c.ID)) } class="flex flex-col" aria-label={ c.Title }>
			if c.IsFeatured() {
				<span class="sr-only">Jasa pilihan pengelola.</span>
			} else if c.PenyediaDisorot() {
				<span class="sr-only">Dari penyedia pilihan pengelola.</span>
			}
			<div class="listing-card-media">
				if c.CoverImage != nil && *c.CoverImage != "" {
					<img
						src={ *c.CoverImage }
						alt={ c.Title }
						loading="lazy"
						decoding="async"
						class="h-full w-full object-cover"
					/>
				} else {
					<span class="flex h-full w-full items-center justify-center" style="color: var(--text-subtle)">
						@Icon("foto", "h-8 w-8")
					</span>
				}
				<!-- Label kategori diletakkan di atas foto agar baris teks di bawah tetap ringkas. -->
				<span
					class="absolute left-2 top-2 rounded-full px-2 py-1 text-2xs font-semibold backdrop-blur"
					style="background-color: var(--nav-blur); color: var(--text)"
				>
					{ c.CategoryName }
				</span>
			</div>
			<div class="flex flex-1 flex-col gap-2 p-3">
				<h3 class="listing-card-title text-sm sm:text-base">{ c.Title }</h3>
				<p class="whitespace-nowrap font-display text-sm font-bold tabular-nums sm:text-base" style="color: var(--text)">
					{ view.HargaLabel(c.PriceType, c.PriceMin, c.PriceMax) }
				</p>
				<div class="mt-auto flex flex-col gap-1.5 pt-1">
					<div class="flex items-center gap-1.5 text-xs">
						@Avatar(avatarNone(), c.ProviderName, "h-5 w-5 text-2xs")
						<span class="clamp-1 font-medium" style="color: var(--text-muted)">{ c.ProviderName }</span>
						@BadgeTerverifikasi(c.IsVerified, false)
					</div>
					<div class="flex items-center justify-between gap-2 text-xs">
						<span class="inline-flex min-w-0 items-center gap-1" style="color: var(--text-muted)">
							@Icon("lokasi", "h-3.5 w-3.5 shrink-0")
							if c.JarakKm != nil {
								<!-- Jarak menggantikan nama wilayah saat pencari jasa sudah
								     menentukan lokasinya: angka jarak lebih menjawab
								     pertanyaan "apakah ini dekat dari saya?". -->
								<span class="clamp-1 font-semibold tabular-nums" style="color: var(--text)">
									{ view.JarakLabel(c.JarakKm) }
								</span>
							} else {
								<span class="clamp-1">{ view.Lokasi(c.ProviderKec, c.ProviderCity) }</span>
							}
						</span>
						<span class="inline-flex items-center gap-2">
							@Dilihat(c.TotalKunjungan, "text-2xs")
							@RatingRingkas(c.AvgRating, c.TotalReviews)
						</span>
					</div>
					if c.JarakKm != nil && !c.Menjangkau() {
						<!-- Jujur di muka: penyedia ini di luar radius layanannya sendiri,
						     jadi belum tentu bersedia datang. -->
						<p class="text-2xs" style="color: var(--text-subtle)">
							Di luar radius layanan penyedia
						</p>
					}
				</div>
			</div>
		</a>
	</article>
}

// ListingCardCompact dipakai di daftar milik provider: baris mendatar, lebih padat,
// dan menyertakan status aktif/nonaktif serta tombol kelola.
templ ListingCardCompact(c model.ServiceCard) {
	<article class="surface-panel flex gap-3 p-3">
		<a href={ templ.SafeURL(fmt.Sprintf("/jasa/%d", c.ID)) } class="shrink-0">
			<span class="block h-20 w-20 overflow-hidden rounded-md" style="background-color: var(--surface)">
				if c.CoverImage != nil && *c.CoverImage != "" {
					<img src={ *c.CoverImage } alt={ c.Title } loading="lazy" class="h-full w-full object-cover"/>
				} else {
					<span class="flex h-full w-full items-center justify-center" style="color: var(--text-subtle)">
						@Icon("foto", "h-5 w-5")
					</span>
				}
			</span>
		</a>
		<div class="flex min-w-0 flex-1 flex-col gap-1">
			<div class="flex items-start justify-between gap-2">
				<a href={ templ.SafeURL(fmt.Sprintf("/jasa/%d", c.ID)) } class="min-w-0">
					<h3 class="clamp-1 text-sm font-semibold">{ c.Title }</h3>
				</a>
				@StatusListing(c.Status)
			</div>
			<p class="text-xs" style="color: var(--text-muted)">{ c.CategoryName }</p>
			<p class="font-display text-sm font-bold">{ view.HargaLabel(c.PriceType, c.PriceMin, c.PriceMax) }</p>
			<div class="mt-1 flex items-center gap-3 text-xs">
				@Dilihat(c.TotalKunjungan, "text-xs")
				<a
					href={ templ.SafeURL(fmt.Sprintf("/jasa/%d/ubah", c.ID)) }
					class="inline-flex items-center gap-1 font-semibold"
					style="color: var(--primary-solid)"
				>
					@Icon("ubah", "h-3.5 w-3.5")
					<span>Kelola</span>
				</a>
				if c.Status == model.ServiceActive && !c.IsFeatured() {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/promosi/baru?jenis=sorotan_jasa&service_id=%d", c.ID)) }
						class="inline-flex items-center gap-1 font-semibold"
						style="color: var(--primary-solid)"
					>
						@Icon("petir", "h-3.5 w-3.5")
						<span>Sorot</span>
					</a>
				}
				<span style="color: var(--text-subtle)">{ view.WaktuRelatif(c.CreatedAt) }</span>
			</div>
		</div>
	</article>
}

// StatusListing menandai listing nonaktif. Listing aktif sengaja tidak diberi
// badge apa pun supaya daftar tidak penuh pill berwarna.
templ StatusListing(status model.ServiceStatus) {
	if status == model.ServiceInactive {
		<span
			class="shrink-0 rounded-full px-2 py-0.5 text-2xs font-semibold"
			style="background-color: var(--surface); color: var(--text-muted); border: 1px solid var(--border)"
		>
			Nonaktif
		</span>
	}
}

// ListingGrid menyusun kartu dalam grid: dua kolom sejak 375px — pola yang
// sudah dikenal pengguna marketplace di Indonesia dan lebih mudah dipindai
// daripada satu kolom — lalu tiga kolom di tablet dan empat di desktop.
templ ListingGrid(items []model.ServiceCard) {
	<div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:grid-cols-4">
		for _, item := range items {
			@ListingCard(item)
		}
	</div>
}

// HitungHasil menampilkan jumlah hasil pencarian.
templ HitungHasil(total int) {
	<p class="text-sm font-medium" style="color: var(--text-muted)">{ hitungLabel(total) }</p>
}

// avatarNone menegaskan kartu listing memakai inisial, bukan memuat foto
// profil tambahan yang akan menambah permintaan jaringan per kartu.
func avatarNone() string { return "" }
