package components

import (
	"github.com/hermansyah/adojobsid/internal/model"
	"github.com/hermansyah/adojobsid/internal/view"
)

// PemilihLokasi menampilkan lokasi acuan yang sedang aktif dan menyediakan
// cara menggantinya. Deteksi GPS ditangani app.js; bila pengguna menolak atau
// perangkatnya tidak mendukung, daftar kecamatan muncul sebagai gantinya.
templ PemilihLokasi(b view.Base, kembaliKe string) {
	<details class="mb-3 inline-block">
		<summary class="pemilih-lokasi-ringkas inline-flex cursor-pointer list-none items-center gap-2 text-xs font-semibold uppercase tracking-widest">
			@Icon("lokasi", "h-4 w-4")
			<span>{ view.TrimLabel(b.Lokasi.Label, 28) }</span>
			if !b.Lokasi.Ditentukan() {
				<span class="pemilih-lokasi-ubah normal-case tracking-normal">· ubah</span>
			}
		</summary>
		<div class="surface-panel mt-2 w-full max-w-sm p-4">
			<p class="mb-3 text-sm font-semibold" style="color: var(--text)">Cari jasa di sekitar mana?</p>
			<form action="/lokasi" method="post" class="flex flex-col gap-2">
				<input type="hidden" name="next" value={ kembaliKe }/>
				<input type="hidden" name="latitude" value=""/>
				<input type="hidden" name="longitude" value=""/>
				<button type="button" class="btn btn-primary w-full" data-deteksi-lokasi>
					@Icon("lokasi", "h-4 w-4")
					Pakai lokasi saya
				</button>
			</form>
			<form action="/lokasi" method="post" class="mt-2" id="pilih-kecamatan">
				<input type="hidden" name="next" value={ kembaliKe }/>
				<label for="lokasi-kecamatan" class="field-label">Atau pilih kecamatan</label>
				<div class="flex gap-2">
					<select id="lokasi-kecamatan" name="kecamatan" class="input !min-h-0 h-10 flex-1 text-sm">
						for _, k := range model.KecamatanBengkalis {
							if k == b.Lokasi.Label {
								<option value={ k } selected>{ k }</option>
							} else {
								<option value={ k }>{ k }</option>
							}
						}
					</select>
					<button type="submit" class="btn btn-secondary !min-h-0 h-10">Pakai</button>
				</div>
			</form>
			if b.Lokasi.Ditentukan() {
				<form action="/lokasi/hapus" method="post" class="mt-3">
					<input type="hidden" name="next" value={ kembaliKe }/>
					<button type="submit" class="btn btn-ghost btn-sm !px-0" style="color: var(--text-muted)">
						Lupakan lokasi saya
					</button>
				</form>
			}
			<p class="mt-3 text-2xs" style="color: var(--text-subtle)">
				Lokasi hanya disimpan di peramban Anda dan dipakai untuk menghitung jarak.
			</p>
		</div>
	</details>
}
